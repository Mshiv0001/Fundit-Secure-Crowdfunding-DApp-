# Get an HTTPS Sepolia RPC URL from a provider such as Alchemy or Infura.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of a dedicated, testnet-only wallet. Never use a wallet holding real funds.
# Include the 0x prefix.
DEPLOYER_PRIVATE_KEY=0xyour-testnet-wallet-private-key

# Frontend deployment settings. Set these in Vercel after deploying the factory.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_FACTORY_ADDRESS=0xYourDeployedFactoryAddress
